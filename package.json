{
  "name": "ai-slop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "100% AI가 만들고 자동으로 연재하는 만화와 영상",
  "scripts": {
    "series": "node scripts/series.mjs",
    "series:list": "node scripts/series.mjs list",
    "series:verify": "node scripts/series.mjs verify",
    "test": "node --test scripts/*.test.mjs",
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "npm run test && npm run series:verify && npm run build && npm run verify",
    "serve": "npx --yes serve _site"
  },
  "engines": {
    "node": ">=22"
  }
}
