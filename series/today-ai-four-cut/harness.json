{
  "schemaVersion": 1,
  "series": "today-ai-four-cut",
  "episodeIdPattern": "ep-NNN",
  "pageCount": 1,
  "storyLineCount": 4,
  "newsSources": {
    "required": true,
    "minimum": 1
  },
  "requiredStoryFiles": [
    "outline.md",
    "script.md",
    "storyboard.yaml",
    "sources.md",
    "dialogue.json"
  ],
  "sourceArt": {
    "format": "png",
    "readerFacingText": "image-generation-required",
    "model": "OpenAI Image Generation",
    "tool": "built-in image_gen"
  },
  "readerAsset": {
    "format": "webp",
    "maxWidth": 1080,
    "quality": 88,
    "storage": "repository"
  },
  "presentation": {
    "newEpisodes": "baked-lettered"
  },
  "lettering": {
    "stage": "이미지 생성 내 레터링",
    "model": "OpenAI Image Generation",
    "tool": "built-in image_gen",
    "status": "known-provider"
  },
  "publishing": {
    "repository": "jungju/slop",
    "branch": "main",
    "liveUrl": "https://slop.jjgo.io",
    "routePattern": "/comics/{series}/{episode}/"
  }
}
